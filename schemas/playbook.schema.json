{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playbook.schema.json",
  "title": "Playbook Package",
  "allOf": [
    {"$ref": "asset-manifest.schema.json"},
    {
      "type": "object",
      "required": ["business_problem", "audience", "entry_criteria", "phases", "included_assets", "exit_criteria"],
      "properties": {
        "asset_type": {"const": "PLY"},
        "business_problem": {"type": "string", "minLength": 1},
        "audience": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "entry_criteria": {"type": "array", "items": {"type": "string"}},
        "phases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "assets", "outcome"]}},
        "included_assets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  ]
}
