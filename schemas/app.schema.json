{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app.schema.json",
  "title": "Application Package",
  "allOf": [
    {"$ref": "asset-manifest.schema.json"},
    {
      "type": "object",
      "required": ["product_outcome", "users", "interfaces", "runtime", "data_classification", "capabilities", "deployment", "test_plan"],
      "properties": {
        "asset_type": {"const": "APP"},
        "product_outcome": {"type": "string", "minLength": 1},
        "users": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "interfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "runtime": {"type": "object", "required": ["platform", "environment"]},
        "data_classification": {"type": "string"},
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "deployment": {"type": "object"},
        "test_plan": {"type": "string", "minLength": 1}
      }
    }
  ]
}
