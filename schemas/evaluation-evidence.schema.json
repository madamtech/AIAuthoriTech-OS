{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-evidence.schema.json",
  "title": "Evaluation Evidence",
  "type": "object",
  "required": ["evaluation_id", "target_sku", "target_version", "executed_at", "evaluator", "test_cases", "result", "critical_failures"],
  "properties": {
    "evaluation_id": {"type": "string", "pattern": "^EV-[0-9]{8}-[0-9]{4}$"},
    "target_sku": {"type": "string", "pattern": "^(AA|LMS|MA|CO)-[A-Z]{3}-[0-9]{6}$"},
    "target_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "executed_at": {"type": "string", "format": "date-time"},
    "evaluator": {"type": "string", "minLength": 1},
    "test_cases": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "scenario", "expected", "observed", "status"], "properties": {"status": {"enum": ["pass", "fail", "blocked"]}}}},
    "result": {"enum": ["pass", "conditional-pass", "fail", "blocked"]},
    "critical_failures": {"type": "array", "items": {"type": "string"}},
    "evidence_files": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
