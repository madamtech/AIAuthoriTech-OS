  "name":{"type":"string"},"asset_type":{"type":"string"},"business":{"enum":["AA","LMS","MA","CO"]},
  "library":{"type":"string"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
