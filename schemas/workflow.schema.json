{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "title": "Workflow Package",
  "allOf": [
    {"$ref": "asset-manifest.schema.json"},
    {
      "type": "object",
      "required": ["trigger", "stages", "state", "completion_criteria", "failure_policy"],
      "properties": {
        "asset_type": {"const": "WFL"},
        "trigger": {"type": "string", "minLength": 1},
        "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "action", "on_success", "on_failure"]}},
        "state": {"type": "array", "items": {"type": "string"}},
        "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "failure_policy": {"type": "object", "required": ["retry_limit", "escalation"]}
      }
    }
  ]
}
