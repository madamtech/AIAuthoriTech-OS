{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-manifest.schema.json",
  "title": "AI AuthoriTech Asset Manifest",
  "type": "object",
  "required": ["sku", "asset_id", "name", "asset_type", "business", "library", "version", "status", "maturity", "description", "owners", "inputs", "outputs", "dependencies"],
  "properties": {
    "sku": {"type": "string", "pattern": "^(AA|LMS|MA|CO)-[A-Z]{3}-[0-9]{6}$"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.v[1-9][0-9]*$"},
    "name": {"type": "string", "minLength": 1},
    "asset_type": {"enum": ["SKL", "WFL", "AGT", "APP", "TMP", "KNP", "PLY", "SOL", "SOP", "DOC", "API", "SCH", "CFG", "TST"]},
    "business": {"enum": ["AA", "LMS", "MA", "CO"]},
    "library": {"type": "string", "minLength": 2},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["concept", "draft", "testing", "approved", "released", "deprecated", "archived"]},
    "maturity": {"type": "integer", "minimum": 0, "maximum": 5},
    "description": {"type": "string", "minLength": 20},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "relationships": {"type": "array", "items": {"type": "string"}}
  }
}
