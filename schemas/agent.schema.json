{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.schema.json",
  "title": "Agent Package",
  "allOf": [
    {"$ref": "asset-manifest.schema.json"},
    {
      "type": "object",
      "required": ["mission", "instructions", "capabilities", "tools", "workflows", "memory_policy", "guardrails", "evaluation_suite"],
      "properties": {
        "asset_type": {"const": "AGT"},
        "mission": {"type": "string", "minLength": 1},
        "instructions": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "tools": {"type": "array", "items": {"type": "string"}},
        "workflows": {"type": "array", "items": {"type": "string"}},
        "memory_policy": {"type": "object"},
        "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evaluation_suite": {"type": "string", "minLength": 1}
      }
    }
  ]
}
