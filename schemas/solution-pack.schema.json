{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solution-pack.schema.json",
  "title": "Solution Pack",
  "allOf": [
    {"$ref": "asset-manifest.schema.json"},
    {
      "type": "object",
      "required": ["business_outcome", "target_customers", "included_assets", "implementation_model", "success_measures", "support_model"],
      "properties": {
        "asset_type": {"const": "SOL"},
        "business_outcome": {"type": "string", "minLength": 1},
        "target_customers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "included_assets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "implementation_model": {"type": "string", "minLength": 1},
        "success_measures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "support_model": {"type": "string", "minLength": 1}
      }
    }
  ]
}
